# Skopiuj do .env i dostosuj.

# Endpoint zgodny z OpenAI Chat Completions. Pusty = tryb heurystyczny (bez LLM, do developmentu).
#   Ollama na komputerze hosta:   http://host.docker.internal:11434/v1
#   Ollama z profilu compose:     http://ollama:11434/v1
LLM_BASE_URL=
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_API_KEY=

# true = LLM wolno wywołać tylko pod adresem lokalnym / w sieci wewnętrznej (inaczej 403).
OFFLINE_MODE=true

# Prefiks znaku sprawy nadawanego automatycznie (gdy urzędnik nie poda numeru).
CASE_NUMBER_PREFIX=BKS.IV.1431

# Frontend (Vite): adres backendu
VITE_API_URL=http://localhost:8000

# Termin odpowiedzi = data wpływu + 14 dni (jak w rejestrze UMB). true = przesuwaj termin z dnia wolnego
# na następny dzień roboczy (art. 57 § 4 KPA).
DEADLINE_SHIFT_TO_WORKING_DAY=false

# Przy pierwszym starcie wczytaj 10 spraw testowych UMB + Zarządzenie 535/2024 (backend/app/seed/umb_demo.json).
SEED_DEMO_DATA=true
