# Skopiuj do .env i wpisz klucz API Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Model Gemini (endpoint zgodny z OpenAI ustawiony domyślnie w backendzie).
LLM_MODEL=gemini-2.5-flash
# "none" wyłącza „myślenie” Gemini 2.5 Flash — szybciej i bez ucinania odpowiedzi JSON.
LLM_REASONING_EFFORT=none

# true = blokuje wysyłkę treści do Gemini (403). Na hackathonie z danymi testowymi: false.
OFFLINE_MODE=false

# Prefiks znaku sprawy nadawanego automatycznie (gdy urzędnik nie poda numeru).
CASE_NUMBER_PREFIX=BKS.IV.1431

# Frontend (Vite): adres backendu
VITE_API_URL=http://localhost:8000

# Termin odpowiedzi = data wpływu + 14 dni (jak w rejestrze UMB). true = przesuwaj termin z dnia wolnego
# na następny dzień roboczy (art. 57 § 4 KPA).
DEADLINE_SHIFT_TO_WORKING_DAY=false

# Przy pierwszym starcie wczytaj 10 spraw testowych UMB + Zarządzenie 535/2024 (backend/app/seed/umb_demo.json).
SEED_DEMO_DATA=true

# Limit rozmiaru wgrywanego pliku (MB) — frontend pobiera go z /api/config.
MAX_UPLOAD_MB=20

# Poziom logowania backendu: DEBUG, INFO, WARNING.
LOG_LEVEL=INFO
